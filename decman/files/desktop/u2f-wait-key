#!/bin/bash
# Lancé par pam_exec avant pam_u2f (kde-fingerprint) : attend que la YubiKey Bio soit branchée. Verrouillé
# KVM basculé, la clé est absente et pam_u2f échouerait aussitôt, sans que kscreenlocker relance.
# Capot ouvert, pas d'attente : le capteur du laptop répond.
grep -qs open /proc/acpi/button/lid/*/state && exit 0
worker=$PPID
# Prête quand elle répond. Accessible ne suffit pas : l'ACL uaccess arrive avec udev, qui au réveil de
# veille traîne plusieurs secondes derrière l'apparition du périphérique dans /sys, et juste après le
# réveil l'ancien hidraw existe encore, accessible, alors que le hub du KVM va déconnecter la clé :
# les trois essais y sont partis en 0,2 s (30/10/2026).
key_ready() {
  local u n
  for u in /sys/class/hidraw/*/device/uevent; do
    grep -qs HID_ID=0003:00001050:00000402 "$u" || continue
    n=${u#/sys/class/hidraw/}; n=${n%%/*}
    timeout 3 fido2-token -I "/dev/$n" >/dev/null 2>&1 && return 0
  done
  return 1
}
until key_ready; do
  # Mot de passe saisi, kscreenlocker tue le worker : ne pas lui survivre.
  sleep 1
done
