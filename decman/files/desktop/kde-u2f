#%PAM-1.0
# Méthode « Universal 2 Factor » du verrou de Plasma (kscreenlocker 6.8, activée par
# Universal2Factor=true dans kscreenlockerrc, dotfiles) : la YubiKey Bio seule. Choisie par son bouton,
# puis retenue pour les verrous suivants ; le verrou relance la pile chaque seconde après un échec, un
# seul essai suffit donc. u2f-wait-key attend d'abord la clé, absente quand le KVM était basculé.
# kde-fingerprint (celui du paquet, fprintd) tourne toujours en parallèle : ne pas y remettre pam_u2f,
# il prendrait la clé avant ce bouton (vérifié le 01/11/2026).

auth       required                    pam_shells.so
auth       requisite                   pam_nologin.so
auth       requisite                   pam_faillock.so      preauth
auth       optional                    pam_exec.so          quiet /usr/local/bin/u2f-wait-key
auth       requisite                   pam_u2f.so           authfile=/etc/u2f_mappings origin=pam://gab appid=pam://gab userverification=1 pinverification=0 cue debug debug_file=syslog
auth       optional                    pam_permit.so
auth       required                    pam_env.so

account    include                     system-local-login

password   required                    pam_deny.so

session    include                     system-local-login
