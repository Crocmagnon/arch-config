#%PAM-1.0
# Copie de /usr/lib/pam.d/kde-fingerprint (kscreenlocker), avec la YubiKey Bio (pam_u2f) avant fprintd :
# sur le laptop capot fermé, fprintd attendrait un doigt sur un capteur inaccessible.

auth       required                    pam_shells.so
auth       requisite                   pam_nologin.so
auth       requisite                   pam_faillock.so      preauth
# Douze essais : pam_u2f ne lit qu'une empreinte par appel, la Bio l'attend 29 s, et kscreenlocker lance
# la pile dès que le pointeur bouge puis ne la relance jamais : avec trois essais, un pointeur qui bouge
# seul les épuisait avant le retour devant l'écran (30/10/2026). Environ 6 min de fenêtre. Chaque ligne
# réussie saute les suivantes et fprintd. Clé absente, chaque essai échoue aussitôt : u2f-wait-key
# l'attend avant chacun, sinon une clé débranchée un instant (KVM, réveil de veille) épuisait les essais.
auth       optional                    pam_exec.so          quiet /usr/local/bin/u2f-wait-key
auth       [success=23 default=ignore] pam_u2f.so           authfile=/etc/u2f_mappings origin=pam://gab appid=pam://gab userverification=1 pinverification=0 cue debug debug_file=syslog
