#!/bin/sh
# Hook systemd-sleep : au réveil derrière le KVM, KWin perd parfois tous ses écrans (« There are no
# outputs ») et l'écran reste noir jusqu'à une bascule aller-retour du KVM (constaté les 23 et
# 25/10/2026). Journaliser l'état des connecteurs, puis forcer une redétection, comme le fait la
# bascule. DIAGNOSTIC : si DP-2 est « connected » pendant l'écran noir, la redétection suffit ;
# s'il est « disconnected », c'est le KVM qui n'envoie plus l'écran.
case "$1" in
    # Hors de systemd-suspend.service, dont le cgroup est tué à la fin des hooks, et sans retarder le réveil.
    post) exec /usr/bin/systemd-run --no-block --collect --quiet "$0" redetect ;;
    redetect) ;;
    *) exit 0 ;;
esac

log_status() {
    s=
    for c in /sys/class/drm/card*-*/status; do
        n=${c%/status}; n=${n##*/}
        case "$n" in *Writeback*) continue ;; esac
        s="$s $n=$(/usr/bin/cat "$c")"
    done
    /usr/bin/logger -t drm-redetect "$1:$s"
}

# Dès le dégel : à 3 s, un aller-retour du KVM fait pendant le réveil était déjà passé (30/10/2026).
log_status 0s
/usr/bin/sleep 3; log_status 3s
/usr/bin/sleep 7; log_status 10s
for c in /sys/class/drm/card*-*/status; do
    case "$c" in *Writeback*) continue ;; esac
    echo detect > "$c"
done
log_status "après detect"
