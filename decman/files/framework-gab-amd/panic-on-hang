#!/bin/sh
# Hook systemd-sleep : pendant une veille ou une hibernation, un blocage du noyau déclenche une
# panique, dont la trace part dans pstore (variables EFI), puis un redémarrage au bout de 10 s.
# Le 28/09/2026, une hibernation s'est figée pendant l'écriture de l'image, CPU à fond, sans aucune
# trace. Le 02/10/2026, la trace a montré un cœur bloqué dans stop_machine juste après la photo
# de la mémoire : la pile de tous les cœurs dira lequel n'arrive pas au rendez-vous. Hors veille,
# on garde les réglages par défaut : pas de panique sur une tâche lente.
# Écriture directe dans /proc/sys : les hooks de veille tournent avec un PATH minimal.
case "$1" in
    pre) v=1 panic=10 ;;
    post) v=0 panic=0 ;;
    *) exit 0 ;;
esac
for knob in softlockup_panic hardlockup_panic hung_task_panic \
    softlockup_all_cpu_backtrace hardlockup_all_cpu_backtrace; do
    echo "$v" > "/proc/sys/kernel/$knob"
done
echo "$panic" > /proc/sys/kernel/panic
